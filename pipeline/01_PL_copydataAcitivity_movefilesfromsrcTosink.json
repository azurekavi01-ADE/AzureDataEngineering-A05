{
	"name": "01_PL_copydataAcitivity_movefilesfromsrcTosink",
	"properties": {
		"description": "This pipeline is to move the files from source to sink",
		"activities": [
			{
				"name": "move file from src to sink",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"wildcardFolderPath": "SourceFiles",
							"wildcardFileName": "*.*",
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_AdeA05_SourceFiles",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_adeA05_sinkFiles",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": [
			"move files from src to sink"
		],
		"lastPublishTime": "2025-12-27T01:16:43Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}