{
	"name": "11_PL_LoaddiffFilestodifftable",
	"properties": {
		"activities": [
			{
				"name": "get all filenames from diffmultifiles",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DQ_ADE_A05_DiffMultifiles",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "loop all the files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "get all filenames from diffmultifiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('get all filenames from diffmultifiles').output.childItems",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "set Filename variable",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "SingleFilename",
								"value": {
									"value": "@item().name",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Copy file to table",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "set Filename variable",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"preCopyScript": {
										"value": "@concat('Truncate Table [dbo].',replace(variables('SingleFilename'),'.csv',''))",
										"type": "Expression"
									},
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false,
									"disableMetricsCollection": false
								},
								"enableStaging": false,
								"translator": {
									"value": "@variables('SingleFilename')",
									"type": "Expression"
								}
							},
							"inputs": [
								{
									"referenceName": "DS_ADEA05_DiffMultifiles_filename",
									"type": "DatasetReference",
									"parameters": {
										"Filename": {
											"value": "@variables('SingleFilename')",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADEA05_DB_ADEA05_TableName",
									"type": "DatasetReference",
									"parameters": {
										"Tablename": {
											"value": "@replace(variables('SingleFilename'),'.csv' ,'' )",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"variables": {
			"SingleFilename": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-01-04T01:53:23Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}