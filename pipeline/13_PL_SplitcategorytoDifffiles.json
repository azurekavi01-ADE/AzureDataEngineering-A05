									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADEA05_SplitedFiles",
									"type": "DatasetReference",
									"parameters": {
										"Filename": {
											"value": "@concat(if(equals(length(variables('singlecatgeory')),0 ),'NA',variables('singlecatgeory')),'.csv')",
											"type": "Expression"
										},
										"dynFolderName": "SplitedFiles"
									}
								}
							]
						}
					]
				}
			}
