								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "singlecatgeory",
								"value": {
									"value": "@item().category",
									"type": "Expression"
								}
							}
						},
						{
							"name": "split data load",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "assign singlecategory",
									"dependencyConditions": [
										"Succeeded"
									]
