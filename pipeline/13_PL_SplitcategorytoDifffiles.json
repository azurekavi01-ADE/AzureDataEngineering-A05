{
	"name": "13_PL_SplitcategorytoDifffiles",
	"properties": {
		"activities": [
			{
				"name": "get distinct catgeory",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
