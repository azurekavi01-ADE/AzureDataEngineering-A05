{
	"name": "Alter row",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Employeetxt",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          EmployeeID as integer,",
				"          First_name as string,",
				"          Last_Name as string,",
				"          MailId as string,",
				"          Contact as string,",
				"          DOJ as string,",
				"          Jobid as string,",
				"          Salary as string,",
				"          MGRID as string,",
				"          DeptID as string,",
				"          Fullname as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 alterRow(deleteIf(lesserOrEqual(EmployeeID, 200)),",
				"     updateIf(equals(Jobid,'10'))) ~> alterRow1"
			]
		}
	}
}