		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-A05"
		},
		"LS_ADLSGEN2_adea05_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLSGEN2_adea05'"
		},
		"LS_ASQL_DB_ADEA05_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_ASQL_DB_ADEA05'"
		},
		"LS_LocalSQLServer_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_LocalSQLServer'"
		},
		"LS_ADLSGEN2_adea05_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adea05.dfs.core.windows.net/"
